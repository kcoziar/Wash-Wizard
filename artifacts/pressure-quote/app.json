{
  "expo": {
    "name": "Wash Quote+",
    "slug": "pressure-quote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pressure-quote",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2F0EB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kozipublishing.pressurequote",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "RCTAsyncStorageExcludeFromBackup": false
      }
    },
    "android": {
      "package": "com.kozipublishing.pressurequote"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a logo to show on your customer quotes.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
